{
  "name": "china-address-parse",
  "version": "1.0.0",
  "description": "chinese address parse",
  "author": "kk",
  "license": "MIT",
  "homepage": "https://github.com/ldwonday/zh-address-parse",
  "main": "./index.js",
  "typings": "./index.d.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev webpack serve --progress --mode development --config config/webpack.config.dev.js",
    "build": "cross-env NODE_ENV=production webpack --progress --mode production --config config/webpack.config.build.js",
    "build-lib": "pnpm run build-lib:default && pnpm run build-lib:nocode",
    "build-lib:default": "cross-env NODE_ENV=production webpack --progress --mode production --config config/webpack.config.build.lib.js",
    "build-lib:nocode": "cross-env NODE_ENV=production webpack --progress --mode production --config config/webpack.config.build.lib.nocode.js",
    "push-release": "sh ./scripts/release.sh",
    "push-dev": "sh ./scripts/dev.sh",
    "fetch-data": "babel-node app/lib/getMcaGovData.js",
    "test": "pnpm run build-lib && pnpm run test:default && pnpm run test:nocode",
    "test:default": "TEST_FILE=zh-address-parse.min.js pnpm exec jest",
    "test:nocode": "TEST_FILE=zh-address-parse.nocode.min.js pnpm exec jest",
    "lint": "eslint app/lib/**/*.js",
    "lint:fix": "eslint app/lib/**/*.js --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ldwonday/zh-address-parse.git"
  },
  "dependencies": {
    "cn-division": "^2025.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "babel-loader": "^9.2.0",
    "cheerio": "^1.0.0-rc.3",
    "clean-webpack-plugin": "^4.0.0",
    "core-js": "^3.45.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^28.1.1",
    "jquery": "^3.4.1",
    "lodash": "^4.17.15",
    "sass": "^1.30.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  }
}
